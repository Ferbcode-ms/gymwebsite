# ====================================================================
# APEX FITNESS - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual credentials.
# ====================================================================

# --------------------------------------------------------------------
# 0. SITE DOMAIN (Crucial for SEO, Canonical URLs, Social Previews & Sitemap)
# Set to your live production domain (e.g., https://apexfitness.com)
# --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://apexfitness.com


# --------------------------------------------------------------------
# 1. SUPABASE (Authentication & PostgreSQL Database)
# Find these in: Supabase Dashboard > Project Settings > API
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------
# 2. CLOUDINARY (Media Storage & CDN Delivery)
# Find these in: Cloudinary Console > Dashboard > Product Environment
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Upload folder prefix inside Cloudinary
NEXT_PUBLIC_CLOUDINARY_FOLDER=gym_website
